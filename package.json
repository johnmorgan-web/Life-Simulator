{
  "name": "life-simulator-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "npm --prefix client run start",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run start:dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint"
  }
}
